---
import Layout from '../layouts/Layout.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';

let html = '';
let css = '';
let hasContent = false;

try {
  const contentPath = join(process.cwd(), 'content', 'pages', 'index.json');
  const content = await readFile(contentPath, 'utf-8');
  const data = JSON.parse(content);
  html = data.html || '';
  css = data.css || '';
  hasContent = !!html;
} catch (error) {
  // No content saved yet
  console.log('No content found, showing default message');
}
---

<Layout title="Home - GrapesJS CMS">
  <style is:global set:html={css}></style>

  {hasContent ? (
    <div set:html={html} />
  ) : (
    <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100">
      <div class="text-center p-8 max-w-2xl">
        <h1 class="text-5xl font-bold text-gray-800 mb-6">
          Welcome to GrapesJS CMS
        </h1>
        <p class="text-xl text-gray-600 mb-8">
          No content has been created yet. Visit the editor to start building your page!
        </p>
        <a
          href="/editor"
          class="inline-block px-8 py-4 bg-blue-600 text-white font-semibold rounded-lg shadow-lg hover:bg-blue-700 transition-colors duration-200"
        >
          Go to Editor
        </a>
        <div class="mt-12 text-left bg-white rounded-lg shadow-md p-6">
          <h2 class="text-2xl font-semibold text-gray-800 mb-4">Features:</h2>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-start">
              <span class="text-blue-600 mr-2">✓</span>
              <span><strong>Hero Component:</strong> Full-width hero section with customizable background image, heading, and description</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 mr-2">✓</span>
              <span><strong>Side-by-Side Component:</strong> Flexible layout with image and text (media-first or media-second on desktop, always image-first on mobile)</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 mr-2">✓</span>
              <span><strong>Visual Editor:</strong> Drag-and-drop interface powered by GrapesJS</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 mr-2">✓</span>
              <span><strong>Image Upload:</strong> Upload and manage images directly in the editor</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 mr-2">✓</span>
              <span><strong>Responsive Design:</strong> Preview your content on desktop, tablet, and mobile devices</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  )}

  <script>
    import '../components/hero-component.ts';
    import '../components/side-by-side-component.ts';
  </script>
</Layout>
